{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-mcp-oauth-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://localhost:8787",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "LOCAL_DEV_IDENTITY": "1",
    "OWNER_EMAIL": "owner@example.com",
    "DEBUG_TOOLS": "0",
    "LOG_MCP_PROTOCOL": "0"
  },
  "env": {
    "production": {
      "name": "health-mcp",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "health-mcp.example.com",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "00000000000000000000000000000000"
        }
      ],
      "vars": {
        "PUBLIC_BASE_URL": "https://health-mcp.example.com",
        "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
        "ACCESS_AUD": "",
        "LOCAL_DEV_IDENTITY": "0",
        "OWNER_EMAIL": "owner@example.com",
        "DEBUG_TOOLS": "0",
        "LOG_MCP_PROTOCOL": "0"
      }
    }
  }
}
